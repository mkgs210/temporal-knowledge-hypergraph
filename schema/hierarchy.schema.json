{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tkh/hierarchy.schema.json",
  "title": "Laminar temporal hypergraph hierarchy",
  "type": "object",
  "required": ["cutoff", "budgets", "levels"],
  "properties": {
    "cutoff": {"type": "integer"},
    "budgets": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 1}},
    "levels": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "required": ["index", "groups"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "groups": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/group"}}
        }
      }
    }
  },
  "$defs": {
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "group": {
      "type": "object",
      "required": ["id", "parent_id", "members", "label", "gloss", "evidence", "label_input_hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "parent_id": {"type": ["string", "null"]},
        "members": {"$ref": "#/$defs/ids"},
        "label": {"type": "string", "pattern": "\\S"},
        "gloss": {"type": "string", "pattern": "\\S"},
        "evidence": {"$ref": "#/$defs/ids"},
        "label_input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
